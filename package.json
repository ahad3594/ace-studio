{
  "name": "ace-studio",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:core": "node --import tsx --test tests/parser.test.ts tests/processor.test.ts tests/batch.test.ts",
    "test:documents": "node scripts/document-tests.mjs",
    "setup:documents": "python3 scripts/setup-documents.py",
    "desktop:build": "python3 desktop/build.py",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.5",
    "@next/env": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "^4.1.12",
    "tailwindcss": "^4.1.18",
    "@tailwindcss/postcss": "^4.1.18",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "jszip": "3.10.1",
    "react-dropzone": "^14.3.8",
    "zustand": "^5.0.8",
    "idb-keyval": "6.2.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@playwright/test": "^1.62.1",
    "tsx": "^4.20.6"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahad3594/ace-studio.git"
  },
  "bugs": {
    "url": "https://github.com/ahad3594/ace-studio/issues"
  },
  "homepage": "https://github.com/ahad3594/ace-studio#readme"
}
