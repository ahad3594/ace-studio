# Server-side only. Leave empty to use Offline Smart Mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_IMAGES=20
MAX_FILE_MB=20
MAX_INPUT_PIXELS=40000000
MAX_OUTPUT_PIXELS=24000000
PROCESS_CONCURRENCY=2
AI_REQUESTS_PER_MINUTE=20
PROCESS_REQUESTS_PER_MINUTE=60
# Set only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Optional paths for source/server installations. Desktop packages configure these.
# ACE_PYTHON=/absolute/path/to/.venv/bin/python
# ACE_SOFFICE=/usr/bin/libreoffice
# ACE_GS=/usr/bin/gs
# ACE_SRGB_PROFILE=/usr/share/color/icc/ghostscript/srgb.icc
# Source-server binding. Desktop always uses loopback.
ACE_HOST=127.0.0.1
